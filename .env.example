# Control-service secrets only. Never mounted in repository task containers.
DECAGENT_DATABASE_URL=postgresql://decagent:change-me@127.0.0.1:5432/decagent
DECAGENT_DATA_DIR=.decagent
DECAGENT_PUBLIC_URL=http://127.0.0.1:8000
DECAGENT_MAIN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
DECAGENT_MAIN_MODEL=qwen3.8-flash
DECAGENT_MAIN_API_KEY=
DECAGENT_JEV_MODEL=~typesafe/jev-latest
DECAGENT_JEV_API_KEY=
DECAGENT_GITHUB_TOKEN=


DECAGENT_JEV_PROVIDER=openrouter

# Runtime configuration. Keep a fixed image ID; configure after building the runner.
DECAGENT_RUNNER_IMAGE=
DECAGENT_GIT_AUTHOR_NAME=DecAgent
DECAGENT_GIT_AUTHOR_EMAIL=
DECAGENT_DECISION_STRATEGY=jev
DECAGENT_JEV_RESERVATION=0.02
DECAGENT_CONTEXT_TOKENS=65536
# Set a versioned price basis before worker calls. Use zero only for confirmed free quota.
DECAGENT_MAIN_PRICE_VERSION=
DECAGENT_MAIN_INPUT_PER_MILLION=
DECAGENT_MAIN_OUTPUT_PER_MILLION=

# Windows host API/business worker; compose.windows.yaml exposes loopback only.
DECAGENT_LOCAL_POSTGRES_PORT=55432
DECAGENT_LOCAL_MCP_PORT=8001
DECAGENT_LOCAL_BROKER_PORT=8002
DECAGENT_LOCAL_DATA_DIR=.decagent/local-control
# Optional explicit local DSN/broker overrides; leave empty to use existing secret files.
DECAGENT_LOCAL_DATABASE_URL=
DECAGENT_LOCAL_BROKER_URL=
# Only use a development-fitted profile that matches actual model and plugin versions.
DECAGENT_BUSINESS_CALIBRATION_FILE=
