# Control-service secrets only. Never mounted in repository task containers.
DECAGENT_DATABASE_URL=postgresql://decagent:change-me@127.0.0.1:5432/decagent
DECAGENT_DATA_DIR=.decagent
DECAGENT_PUBLIC_URL=http://127.0.0.1:8000
# Keep disabled until guest resource admission and local delivery are accepted.
DECAGENT_GUEST_TRIAL_ENABLED=false
# Comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-For/Proto; empty trusts none.
DECAGENT_GUEST_TRUSTED_PROXIES=
DECAGENT_GUEST_TRIAL_DAILY_COST_USD=5.00
DECAGENT_GUEST_TRIAL_DAILY_QWEN_TOKENS=5000000
DECAGENT_GUEST_TRIAL_DAILY_TASKS_PER_GUEST=30
DECAGENT_GUEST_TRIAL_DAILY_QWEN_TOKENS_PER_GUEST=500000
# Demo snapshot; refresh from CFETS before enabling CNY-budgeted trials. Quotes older than 7 days fail closed.
DECAGENT_GUEST_TRIAL_FX_SOURCE_DATE=2026-10-20
DECAGENT_GUEST_TRIAL_FX_CNY_PER_USD=6.7200
DECAGENT_GUEST_TRIAL_FX_SOURCE_URL=https://www.chinamoney.com.cn/english/
DECAGENT_GUEST_TRIAL_FX_SAFETY_MARGIN_BPS=1000
DECAGENT_MAIN_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
DECAGENT_MAIN_MODEL=qwen3.8-flash
DECAGENT_MAIN_API_KEY=
DECAGENT_MAIN_PROVIDER=qwen
DECAGENT_MAIN_FALLBACK_ENABLED=false
DECAGENT_MAIN_FALLBACK_MODEL=deepseek/deepseek-v4.1-flash
DECAGENT_MAIN_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
DECAGENT_JEV_MODEL=~typesafe/jev-latest
DECAGENT_JEV_API_KEY=
DECAGENT_GITHUB_TOKEN=

# Required before enabling guest trials. Keep this random 32-byte (64 hex-character)
# secret stable across restarts and every API instance; do not store it in PostgreSQL.
# The app stores only a keyed fingerprint and blocks admissions if recent windows are still active.
# Disable guest admissions, wait until 2 hours after the last event, then change this key.
DECAGENT_GUEST_RATE_LIMIT_HMAC_KEY=


DECAGENT_JEV_PROVIDER=openrouter

# Runtime configuration. Keep a fixed image ID; configure after building the runner.
DECAGENT_RUNNER_IMAGE=
DECAGENT_GIT_AUTHOR_NAME=DecAgent
DECAGENT_GIT_AUTHOR_EMAIL=
DECAGENT_DECISION_STRATEGY=jev
DECAGENT_JEV_RESERVATION=0.02
DECAGENT_CONTEXT_TOKENS=65536
# Set a versioned price basis before guest model calls. Qwen rates must match the
# endpoint/account pricing at https://platform.qianwenai.com/pricing/api .
# Keep the gross API rate even when vouchers reduce cash paid; use zero only when
# the provider confirms the API charge itself is zero.
DECAGENT_MAIN_PRICE_VERSION=
DECAGENT_MAIN_PRICE_CURRENCY=CNY
DECAGENT_MAIN_INPUT_PER_MILLION=
DECAGENT_MAIN_OUTPUT_PER_MILLION=
DECAGENT_MAIN_MAX_ATTEMPTS=2
DECAGENT_MAIN_RETRY_AFTER_THRESHOLD=30
DECAGENT_MODEL_MAX_INPUT_TOKENS=65536
# Optional fallback pricing/reservation. Required before fallback can be enabled.
DECAGENT_MAIN_FALLBACK_PRICE_VERSION=
DECAGENT_MAIN_FALLBACK_PRICE_CURRENCY=USD
DECAGENT_MAIN_FALLBACK_INPUT_PER_MILLION=
DECAGENT_MAIN_FALLBACK_OUTPUT_PER_MILLION=
DECAGENT_MAIN_FALLBACK_UNKNOWN_RESERVATION=

# Windows host API/business worker; compose.windows.yaml exposes loopback only.
DECAGENT_LOCAL_POSTGRES_PORT=55432
DECAGENT_LOCAL_MCP_PORT=8001
DECAGENT_LOCAL_BROKER_PORT=8002
DECAGENT_LOCAL_DATA_DIR=.decagent/local-control
# Optional explicit local DSN/broker overrides; leave empty to use existing secret files.
DECAGENT_LOCAL_DATABASE_URL=
DECAGENT_LOCAL_BROKER_URL=
# Only use a development-fitted profile that matches actual model and plugin versions.
DECAGENT_BUSINESS_CALIBRATION_FILE=
